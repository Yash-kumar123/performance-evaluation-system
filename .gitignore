# =============================================================================
# Performance Evaluation System - Production .gitignore
# Multi-Tenant Application (Node.js Backend & Flutter Frontend)
# =============================================================================

# -----------------------------------------------------------------------------
# General & OS Specific Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.trash/

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
logs/

# Temporary / Scratch Files
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# -----------------------------------------------------------------------------
# Node.js / Express Backend
# -----------------------------------------------------------------------------
node_modules/
backend/node_modules/
coverage/
backend/coverage/
dist/
backend/dist/

# Environment Variables & Secrets (NEVER COMMIT REAL ENVS)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env

# Explicitly Keep Example Environment Files Tracked
!.env.example
!backend/.env.example

# Runtime Data & Caches
.npm
.eslintcache
.node_repl_history

# -----------------------------------------------------------------------------
# Flutter & Dart Frontend
# -----------------------------------------------------------------------------
.dart_tool/
frontend/.dart_tool/
.packages
frontend/.packages
.pub/
frontend/.pub/
.pub-cache/
frontend/.pub-cache/

# Flutter Build Artifacts (Keep compiled web build out of Git, or build on CI)
frontend/build/
*.apk
*.aab
*.app
*.ipa

# Generated Flutter Plugin Files
.flutter-plugins
frontend/.flutter-plugins
.flutter-plugins-dependencies
frontend/.flutter-plugins-dependencies

# Android Specific
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/release/
frontend/android/app/debug/
*.keystore
!frontend/android/app/key.properties

# iOS Specific
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/ios/Runner.xcworkspace/
frontend/ios/Runner.xcodeproj/project.xcworkspace/
frontend/ios/Runner.xcodeproj/xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.moved-aside

# -----------------------------------------------------------------------------
# IDE & Code Editor Files
# -----------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ / Android Studio
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.metadata
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings/
.loadpath
.recommenders

# -----------------------------------------------------------------------------
# Explicitly Track Core Documentation & System Files
# -----------------------------------------------------------------------------
!README.md
!backend/README.md
!frontend/README.md
