# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-region.pooler.supabase.com:6543/postgres

# JWT Secret & Expiration
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRES_IN=24h

# CORS Configuration
# Use * for open access, or restrict to your frontend domain in production:
# CORS_ORIGIN=https://performance-evaluation-system-gacb.onrender.com
CORS_ORIGIN=*

# Production Render Deployment URL
# https://performance-evaluation-system-gacb.onrender.com
